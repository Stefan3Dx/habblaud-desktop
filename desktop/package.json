{
  "name": "habblaud-desktop",
  "productName": "Habblaud",
  "version": "1.0.3",
  "private": true,
  "description": "Habblaud Desktop: chat Claude Code + biroul Habblaud",
  "author": "Stormvault (bazat pe Habblaud de Márcio Junior)",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "stage": "node scripts/stage.mjs",
    "dist": "node scripts/stage.mjs && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "ffmpeg-static": "^5.3.0",
    "marked": "^18.1.2",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ro.stormvault.habblaud",
    "productName": "Habblaud",
    "copyright": "MIT · Habblaud de Márcio Junior · Desktop de Stormvault",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "ui/**",
      "icon.ico",
      "icon.png",
      "package.json",
      "!**/*.map",
      "!**/{test,tests,__tests__,docs,example,examples}/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/ffmpeg-static/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/habblaud",
        "to": "habblaud"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Habblaud",
      "artifactName": "Habblaud-Setup-${version}.${ext}"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Stefan3Dx/habblaud-desktop.git"
  }
}
